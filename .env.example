# Proveedor del modelo: anthropic | openai | mock  (si no hay clave, se usa mock automáticamente)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# Alternativa compatible con OpenAI (OpenAI, Azure, Mistral, Ollama…)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Límites de costo y robustez
MAX_ITERACIONES=25
MAX_TOKENS_SESION=200000
LLM_TIMEOUT_MS=60000

# Opcionales
PORT=3000
# Protege el link público: el front pide esta clave
ACCESS_KEY=
# Fija la fecha para evaluar vigencias de soportes (YYYY-MM-DD). Por defecto: hoy en TZ
FECHA_EJECUCION=
TZ=America/Bogota
