{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "bun"
    ],
    "noEmit": true
  },
  "include": [
    "src",
    "demo.ts",
    "modulo",
    "scripts",
    "test"
  ]
}